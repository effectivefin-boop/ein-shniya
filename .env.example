# ── Analytics (עין שנייה) ──────────────────────────────────────────
# Prefer Google Tag Manager as the single hub. Put GA4, Meta Pixel,
# Clarity, Hotjar, LinkedIn Insight, etc. as tags *inside* the GTM
# container — then you only need NEXT_PUBLIC_GTM_ID here.
#
# IDs are public by design (they ship to the browser). Still never
# commit real production values if your repo is public; set them in
# Vercel / hosting env instead.

# Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Optional direct fallbacks (skip if already configured in GTM)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# true (default) = show consent banner and load tags only after "לאשר מדידה"
# false = load tags immediately (only if legal counsel approves)
NEXT_PUBLIC_ANALYTICS_CONSENT_REQUIRED=true

# ── Supabase (leads + admin auth) ──────────────────────────────────
# Project: ein-shniya (ref gdyrytpwuptobmrnimuo, Frankfurt)
# Get keys from Supabase Dashboard → Project Settings → API.
# Never commit real secrets; put them in .env.local / Vercel env.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist (magic-link / OTP). Only this email may enter /admin.
ADMIN_EMAIL=effective.fin@gmail.com
